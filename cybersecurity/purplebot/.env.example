
# Telegram Bot Configuration
# Get your token from @BotFather
TELEGRAM_TOKEN=YOUR_TELEGRAM_TOKEN

# Get your chat_id from @userinfobot
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Log file path
LOG_FILE=/var/log/auth.log

# Alert threshold (number of failed attempts)
THRESHOLD=5

# Look up attacker country via ip-api.com (private IPs are never sent)
ENABLE_GEOIP=true

# Max sources listed in a report
MAX_SOURCES=10
